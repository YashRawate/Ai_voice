# ── LiveKit (Cloud / Self-hosted) ─────────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
OUTBOUND_TRUNK_ID=ST_xxxx
CALL_TO=+91xxxxxxxxxx
BACKEND_REPORT_URL=http://localhost:5000

# ── Sarvam (STT + TTS) ────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_PROVIDER=azure
LLM_FALLBACK=groq,gemini
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
MAX_REPLY_TOKENS=100
MAX_HISTORY_ITEMS=6
EOU_MIN_DELAY=0.15
PREEMPTIVE_GENERATION=true
PATTERN_MATCHING=true
ENABLE_CONTEXT_FILLERS=true

# ── Voice & Audio Settings ────────────────────────────────────────────────────
TTS_LANGUAGE=en-IN
SARVAM_SPEAKER=shreya
AZURE_REALTIME_VOICE=coral
TTS_PACE=1.12
MULTILANG=true
AUTO_SWITCH_LANGUAGE=true
STT_LANGUAGE=unknown
ALLOWED_LANGUAGES=en-IN,hi-IN,te-IN,ta-IN
ENABLE_SLANG=false
INTERRUPTION_MIN_DURATION=0.20
NOISE_CANCELLATION=true

# ── Azure AI Foundry Configuration ───────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_AGENT_ID=
AZURE_AGENT_NAME=PriyaAdmissionsAgent

# ── Session Context & Memory Architecture ─────────────────────────────────────
SESSION_STORAGE=memory
MAX_CONTEXT_TURNS=3
AVOID_QUESTION_REPETITION=true
ENABLE_GOODBYE_DETECTION=true
AUTO_HANGUP_ON_GOODBYE=true
ENABLE_PARALLEL_MEMORY=true
MEMORY_ASYNC_EXTRACTION=true
MEMORY_CONFLICT_GUARD=true
MEMORY_READ_TIMEOUT_MS=25
MEMORY_STORAGE_DIR=.memory_cache

# ── Redis Memory Architecture ─────────────────────────────────────────────────
ENABLE_REDIS_MEMORY=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_CALL_TTL_SECONDS=1200
REDIS_TIMEOUT_MS=100

# ── Azure Cloud Managed Services ──────────────────────────────────────────────
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE=priya_db
AZURE_COSMOS_CONTAINER=conversations
AZURE_APPCONFIG_CONNECTION_STRING=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=university-kb

# ── Dual-Mode Audio Pipeline ──────────────────────────────────────────────────
AUDIO_PIPELINE=direct
USE_LIVEKIT=false
DIRECT_SERVER_HOST=0.0.0.0
DIRECT_SERVER_PORT=8000
DIRECT_PUBLIC_URL=wss://your-domain.ngrok-free.app/media-stream
